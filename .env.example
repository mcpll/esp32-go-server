# Copy to .env and fill the empty values. Do not commit .env.
# Password: at least 8 characters.

# Required. PocketBase creates the console user and the superuser from these.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Required. The device server refuses to start when any of these is empty
# or equal to a known upstream default.
WEBSOCKET_TOKEN=
ENDPOINT_AUTH_TOKEN=
MQTT_SERVER_PASSWORD=
VISION_TOKEN=

# DashScope key for the seeded Italian ASR, LLM and TTS.
# The stack boots with this empty. A voice turn needs a real key.
DASHSCOPE_API_KEY=

# Optional. Required only when mqtt_server.enable_auth is on.
# MQTT_SERVER_SIGNATURE_KEY=

# Optional. Long memory (memory_mode: long).
# MEM0_API_KEY=

# Optional Redis profile: docker compose --profile redis up --build -d
# REDIS_ENABLE=true
# REDIS_HOST=redis
# REDIS_PASSWORD=
# REDIS_PORT=6379
